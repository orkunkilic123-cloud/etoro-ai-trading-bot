# Documentation only: .env files are NOT automatically loaded.
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_ENVIRONMENT=demo
# Set only after confirming the user key is Demo-bound in eToro key management.
ETORO_DEMO_KEY_CONFIRMED=false

# Optional Alpaca market data only. No .env file is loaded automatically.
# Keep values local; never paste credentials into chat or command history.
ALPACA_DATA_API_KEY=
ALPACA_DATA_API_SECRET=
# Confirm Basic IEX access and applicable account/exchange terms before opting in.
ALPACA_DATA_FREE_ACCESS_CONFIRMED=false
